# Android v2 fstab for fs_mgr and bootloader-message handling.
system /system_root erofs ro logical,slotselect
system_ext /system_ext erofs ro logical,slotselect
product /product erofs ro logical,slotselect
vendor /vendor erofs ro logical,slotselect
vendor_dlkm /vendor_dlkm erofs ro logical,slotselect
system_dlkm /system_dlkm erofs ro logical,slotselect
/dev/block/bootdevice/by-name/metadata /metadata f2fs defaults defaults
/dev/block/bootdevice/by-name/userdata /data f2fs defaults wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/boot /boot emmc defaults slotselect
/dev/block/bootdevice/by-name/init_boot /init_boot emmc defaults slotselect
/dev/block/bootdevice/by-name/vendor_boot /vendor_boot emmc defaults slotselect
/dev/block/bootdevice/by-name/recovery /recovery emmc defaults slotselect
/dev/block/bootdevice/by-name/dtbo /dtbo emmc defaults slotselect
/dev/block/bootdevice/by-name/misc /misc emmc defaults defaults
/dev/block/mmcblk1p1 /external_sd auto defaults defaults
/dev/block/sda1 /usb_otg auto defaults defaults
