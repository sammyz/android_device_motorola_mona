# SurfaceFlinger Display - Lock 120Hz Constant & Disable Idle Downclocking
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.set_idle_timer_ms=0
ro.surface_flinger.set_touch_timer_ms=0

# Telephony - Default to 5G NR + LTE (Mode 33) & Max Modems
ro.telephony.default_network=33,33
telephony.active_modems.max=2
